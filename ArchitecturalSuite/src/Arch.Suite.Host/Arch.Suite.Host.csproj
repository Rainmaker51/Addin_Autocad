<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.4.0</Version>
    <AutoCadDir Condition="'$(AutoCadDir)'==''">$(ProgramFiles)/Autodesk/AutoCAD 2021</AutoCadDir>
    <ManagerRepo Condition="'$(ManagerRepo)'==''">$(MSBuildProjectDirectory)/../../../../AI-CAD-MCP</ManagerRepo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CAD.Contracts" HintPath="$(ManagerRepo)/src/CAD.Contracts/bin/Release/netstandard2.0/CAD.Contracts.dll" Private="false"/>
    <Reference Include="CAD.Bridge.AutoCAD" HintPath="$(ManagerRepo)/src/CAD.Bridge.AutoCAD/bin/Release/net48/CAD.Bridge.AutoCAD.dll" Private="false"/>
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagerRepo)/src/CAD.Bridge.AutoCAD/bin/Release/net48/Newtonsoft.Json.dll" Private="false"/>
    <Reference Include="acmgd" HintPath="$(AutoCadDir)/acmgd.dll" Private="false"/>
    <Reference Include="acdbmgd" HintPath="$(AutoCadDir)/acdbmgd.dll" Private="false"/>
    <Reference Include="accoremgd" HintPath="$(AutoCadDir)/accoremgd.dll" Private="false"/>
    <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/><Reference Include="System.Xaml"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="System.Data"/><Reference Include="System.Drawing"/>
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="$(ManagerRepo)/src/CAD.Bridge.AutoCAD/CadToolTheme.xaml" LogicalName="Arch.Suite.Host.CadToolTheme.xaml" /></ItemGroup>
</Project>
